AI_SERVICE_KEY=replace-with-a-random-secret
AI_CALLBACK_SECRET=replace-with-a-different-random-secret

S3_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-1
S3_BUCKET=chicken-case
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Path tương đối tính từ thư mục ai-service/
# Local: file tồn tại sẵn tại ai-service/A/final_convnext_tiny.pth (không commit vào git)
# Deploy: file sẽ được tự động download từ HF Hub khi khởi động nếu không có
AI_MODEL_PATH=A/final_convnext_tiny.pth
AI_MODEL_VERSION=convnext_tiny-ensemble-v1
AI_DEVICE=cpu

# Hugging Face Hub — chỉ cần thiết trên server deploy (khi file .pth chưa có)
# Local: giữ nguyên hoặc bỏ trống nếu đã có file tại AI_MODEL_PATH
# Deploy: BẮT BUỘC phải có để auto-download model khi service khởi động
HF_MODEL_REPO=your-username/your-model-repo
HF_MODEL_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXX
